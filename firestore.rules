rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================
    // Users collection
    // =========================================
    match /users/{userId} {

      // --- Read: own document or admin ---
      allow read: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();

      // --- Write (user on own doc): restricted fields only ---
      allow update: if request.auth != null
        && request.auth.uid == userId
        // Block role changes — users must NEVER change their own role
        && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
        // Block email changes
        && (!('email' in request.resource.data) || request.resource.data.email == resource.data.email)
        // Block createdAt changes
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        // remainingTime is optional on older accounts. When present: students may
        // only count down, except the monthly auto-reset path below.
        && (
          !('remainingTime' in request.resource.data)
          || (
            request.resource.data.remainingTime is number
            && request.resource.data.remainingTime >= 0
            && (
              request.resource.data.remainingTime <= resource.data.get('remainingTime', 0)
              || (
                request.resource.data.remainingTime
                  == get(/databases/$(database)/documents/settings/monthlyAutoSet).data.resetSeconds
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['remainingTime', 'lastAutoSet', 'updatedAt'])
                && request.resource.data.lastAutoSet is timestamp
                && request.resource.data.lastAutoSet
                  > resource.data.get('lastAutoSet', timestamp.date(1970, 1, 1))
              )
            )
          )
        )
        // Quest progress sync from student app
        && (!('beginnerProgress' in request.resource.data)
            || request.resource.data.beginnerProgress is map)
        && (!('intermediateProgress' in request.resource.data)
            || request.resource.data.intermediateProgress is map)
        && (!('advancedProgress' in request.resource.data)
            || request.resource.data.advancedProgress is map)
        && (!('progressUpdatedAt' in request.resource.data)
            || request.resource.data.progressUpdatedAt is timestamp)
        && (!('lessonBadges' in request.resource.data)
            || request.resource.data.lessonBadges is list)
        && (!('badgeRevocations' in request.resource.data)
            || request.resource.data.badgeRevocations is list)
        && (!('skipStats' in request.resource.data)
            || request.resource.data.skipStats is map)
        && (!('mcqStats' in request.resource.data)
            || request.resource.data.mcqStats is map)
        && (!('pokeStats' in request.resource.data)
            || request.resource.data.pokeStats is map)
        && request.resource.data.get('linkedStudentIds', []) == resource.data.get('linkedStudentIds', [])
        && request.resource.data.get('linkedParentIds', []) == resource.data.get('linkedParentIds', [])
        && request.resource.data.get('linkedChildren', []) == resource.data.get('linkedChildren', [])
        && request.resource.data.get('linkCode', '') == resource.data.get('linkCode', '')
        && request.resource.data.get('xp', 0) == resource.data.get('xp', 0);

      // Users cannot create or delete their own documents
      allow create, delete: if false;

      // Staff can manage ordinary accounts. Clients cannot create, edit, or delete the owner.
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.get('role', '') != 'owner';
      allow update: if isAdmin()
        && resource.data.get('role', '') != 'owner'
        && request.resource.data.get('role', '') != 'owner';
      allow delete: if isAdmin() && resource.data.get('role', '') != 'owner';

      match /pushTokens/{tokenId} {
        allow read, write: if false;
      }

      // Activity feed: skips, stars, badges, resets
      match /activity/{eventId} {
        allow read: if isAdmin()
          || (request.auth != null && request.auth.uid == userId);

        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.type is string
          && request.resource.data.source == 'client'
          && request.resource.data.keys().hasAll(['type', 'source', 'at']);

        // 「最初から」 lets a student erase their own Part 1 activity history.
        // The path is restricted to the authenticated user's own document.
        allow delete: if request.auth != null
          && request.auth.uid == userId;

        allow create, update, delete: if isAdmin();
      }

      // COllAB favorites — keep nested under users so list/get always resolve here.
      match /collabFavorites/{templateId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Allow admins to list all users (collection-level query)
    match /users/{document=**} {
      allow list: if isAdmin();
    }

    // =========================================
    // Settings collection
    // =========================================
    match /settings/{settingId} {
      // Any authenticated user can read settings (needed for auto-reset check)
      allow read: if request.auth != null;

      // Ticket amounts are changed only by the platform owner. Other settings stay with staff.
      allow write: if settingId == 'ticketPolicy'
        ? isOwner()
        : isAdmin();
    }

    // Classes, bookings and tickets are written only by Cloud Functions (Admin SDK).
    match /classes/{classId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /bookings/{bookingId} {
      allow read: if request.auth != null && (
        resource.data.studentId == request.auth.uid
        || resource.data.bookedBy == request.auth.uid
        || resource.data.teacherId == request.auth.uid
        || linkedParentOf(resource.data.studentId)
        || isAdmin()
      );
      allow write: if false;
    }

    match /ticketBalances/{studentId} {
      allow read: if request.auth != null
        && (request.auth.uid == studentId || isAdmin() || linkedParentOf(studentId));
      allow write: if false;
    }

    match /attendance/{classId} {
      allow read: if request.auth != null
        && (resource.data.teacherId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /classReports/{reportId} {
      allow read: if request.auth != null && (
        resource.data.teacherId == request.auth.uid
        || request.auth.uid in resource.data.get('attendeeIds', [])
        || isAdmin()
      );
      allow write: if false;
    }

    match /homeworkKeys/{assignmentId} {
      allow read, write: if false;
    }

    // Premade Learny clips shared across teachers/students.
    // Doc id = hash of the spoken line (cacheKey). Reuse skips Gemini credits.
    // Any signed-in user may write — content is spoken homework phrases only.
    match /homeworkVoice/{clipId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.pcm is string
        && request.resource.data.pcm.size() < 950000
        && request.resource.data.rate == 24000
        && (!('key' in request.resource.data) || request.resource.data.key is string)
        && (!('text' in request.resource.data) || request.resource.data.text is string)
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);
      allow delete: if false;
    }

    match /homeworkAssignments/{assignmentId} {
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.get('assigneeIds', [])
        || resource.data.teacherId == request.auth.uid
        || isAdmin()
        || (resource.data.get('published', false) == true && resource.data.get('status', '') == 'draft')
      );
      allow write: if false;
    }

    match /studentHomework/{studentId}/items/{itemId} {
      allow read: if request.auth != null
        && (request.auth.uid == studentId || isAdmin() || linkedParentOf(studentId));
      allow write: if false;
    }

    match /homeworkProgress/{progressId} {
      allow read: if request.auth != null
        && (resource.data.studentId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /inbox/{userId}/items/{itemId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    match /quizTemplates/{templateId} {
      // Use direct field checks (not map.get defaults) so list queries with
      // where("visibility"=="published") / where("ownerId"==uid) can be proven.
      allow get: if request.auth != null && (
        resource.data.ownerId == request.auth.uid
        || resource.data.visibility in ['published', 'unlisted']
        || isAdmin()
      );
      allow list: if request.auth != null && (
        resource.data.ownerId == request.auth.uid
        || resource.data.visibility == 'published'
        || isAdmin()
      );
      allow write: if false;
    }

    match /quizRooms/{roomId} {
      allow get: if request.auth != null && (
        resource.data.hostId == request.auth.uid
        || exists(/databases/$(database)/documents/quizRooms/$(roomId)/players/$(request.auth.uid))
        || isAdmin()
      );
      allow list, write: if false;

      match /players/{playerId} {
        allow read: if request.auth != null && (
          request.auth.uid == playerId
          || isQuizHost(roomId)
          || isAdmin()
        );
        allow write: if false;
      }

      match /secure/{docId} {
        allow read: if isQuizHost(roomId) || isAdmin();
        allow write: if false;
      }
    }

    match /quizSessions/{sessionId} {
      allow read: if request.auth != null && (
        resource.data.hostId == request.auth.uid
        || isAdmin()
      );
      allow write: if false;
    }

    match /slotHolds/{holdId} {
      allow read, write: if false;
    }

    // =========================================
    // Helper function: check admin role
    // =========================================
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'owner'];
    }

    function linkedParentOf(studentId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && studentId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('linkedStudentIds', []);
    }

    function isQuizHost(roomId) {
      return request.auth != null
        && get(/databases/$(database)/documents/quizRooms/$(roomId)).data.hostId == request.auth.uid;
    }

    // Owner privilege is role-based. Client rules already block creating/updating
    // users to role == 'owner'; sensitive owner email lives only in functions/.env.
    function isOwner() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    // =========================================
    // Deny all other collections by default
    // =========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
